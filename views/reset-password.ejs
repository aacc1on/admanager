<!-- File: views/reset-password.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Password Reset — User Provisioning</title>
  <link rel="icon" href="https://upload.wikimedia.org/wikipedia/commons/0/03/Bet_logo.png" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <main class="container">
    <header class="top-bar">
      <div class="top-bar-actions">
        <a href="/" class="link-button">Back to form</a>
        <% if (role === 'admin') { %>
          <a href="/admin" class="link-button">Admin Panel</a>
        <% } %>
        <form method="POST" action="/logout" class="logout-form">
          <span class="signed-in-as">Signed in as <strong><%= username %></strong></span>
          <button type="submit" class="link-button">Sign out</button>
        </form>
      </div>
    </header>

    <div class="brand-banner">
      <img class="brand-logo" src="https://upload.wikimedia.org/wikipedia/commons/0/03/Bet_logo.png" alt="BetConstruct logo" />
      <h1>Password Reset</h1>
    </div>

    <form id="resetForm" novalidate>
      <label>AD Account Email (to reset)
        <input type="email" name="targetEmail" id="targetEmail" required placeholder="john.smith@bcapps.cloud" />
        <span class="hint">The address ADManager Plus will search for (AD "mail" attribute) and reset the password of.</span>
      </label>

      <label>Send New Password To
        <input type="email" name="notifyEmail" id="notifyEmail" required placeholder="john.smith@company.com" />
        <span class="hint">Where the new password will be emailed — can be a different address than the one above.</span>
      </label>

      <button type="submit" id="resetSubmitBtn">Reset Password</button>
    </form>

    <section id="statusWindow" class="status-window" hidden>
      <h2>Status</h2>
      <ul id="statusList"></ul>
    </section>
  </main>
  <script src="/js/reset-password.js"></script>
</body>
</html>
