<!-- File: views/reset-password.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Password Reset — User Provisioning</title>
  <link rel="icon" href="https://upload.wikimedia.org/wikipedia/commons/0/03/Bet_logo.png" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <main class="container">
    <header class="top-bar">
      <div class="top-bar-actions">
        <a href="/" class="link-button">Back to form</a>
        <a href="/groups" class="link-button">Groups</a>
        <a href="/directory" class="link-button">Directory</a>
        <% if (role === 'admin') { %>
          <a href="/admin" class="link-button">Admin Panel</a>
        <% } %>
        <form method="POST" action="/logout" class="logout-form">
          <span class="signed-in-as">Signed in as <strong><%= username %></strong></span>
          <button type="submit" class="link-button">Sign out</button>
        </form>
      </div>
    </header>

    <div class="brand-banner">
      <img class="brand-logo" src="https://upload.wikimedia.org/wikipedia/commons/0/03/Bet_logo.png" alt="BetConstruct logo" />
      <h1>Password Reset</h1>
    </div>

    <form id="resetForm" novalidate>
      <div class="users-section">
        <div class="users-section-header">
          <span>Users to reset <span class="users-count" id="resetCount">(1)</span></span>
          <button type="button" id="addResetBtn" class="secondary-btn">+ Add another user</button>
        </div>
        <div id="resetRows"></div>
      </div>

      <button type="submit" id="resetSubmitBtn">Reset Password(s)</button>
    </form>

    <template id="resetRowTemplate">
      <div class="user-row" data-reset-row>
        <div class="user-row-header">
          <span class="user-row-title">User <span data-row-number>1</span></span>
          <button type="button" class="remove-user-btn" data-remove-row>Remove</button>
        </div>

        <label>Find a user
          <input type="text" data-quick-search placeholder="Search the imported AD directory by name, SAM account or company..." autocomplete="off" />
        </label>
        <div class="group-list" data-quick-list hidden></div>
        <span class="hint">Selecting a user below fills in their AD account email. Only accounts with a mailbox can be reset here.</span>

        <label>AD Account Email (to reset)
          <input type="email" data-field="targetEmail" required placeholder="john.smith@bcapps.cloud" />
          <span class="hint">The address ADManager Plus will search for (AD "mail" attribute) and reset the password of.</span>
        </label>

        <label>Send New Password To
          <input type="text" data-field="notifyEmail" required placeholder="john.smith@company.com, backup@company.com" />
          <span class="hint">One or more addresses, comma-separated — can differ from the account above.</span>
        </label>
      </div>
    </template>

    <section id="statusWindow" class="status-window" hidden>
      <h2>Status</h2>
      <ul id="statusList"></ul>
    </section>
  </main>
  <script src="/js/reset-password.js"></script>
</body>
</html>
